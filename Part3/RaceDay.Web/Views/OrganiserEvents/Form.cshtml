@using Microsoft.AspNetCore.Mvc.Rendering
@model EventFormViewModel
@{
    var isEdit = Model.EventId > 0;
    ViewData["Title"] = isEdit ? "Edit event" : "New event";
}
<div class="container">
    <nav aria-label="breadcrumb" class="pt-4">
        <a asp-action="Index" class="text-decoration-none"><i class="bi bi-arrow-left"></i> My events</a>
    </nav>

    <div class="rd-page-head">
        <div>
            <span class="rd-eyebrow">@(isEdit ? "Update the details" : "Set up your race")</span>
            <h1>@(isEdit ? "Edit event" : "New event")</h1>
        </div>
    </div>

    <div class="rd-card rd-card-pad mb-5">
        <form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@(isEdit ? Model.EventId : (int?)null)" method="post" enctype="multipart/form-data" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="row g-3">
                <div class="col-md-8">
                    <label asp-for="EventName" class="form-label"></label>
                    <input asp-for="EventName" class="form-control" maxlength="100" autofocus />
                    <span asp-validation-for="EventName" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="EventDate" class="form-label"></label>
                    <input asp-for="EventDate" type="date" class="form-control" />
                    <span asp-validation-for="EventDate" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Location" class="form-label"></label>
                    <input asp-for="Location" class="form-control" maxlength="150" />
                    <span asp-validation-for="Location" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="EventType" class="form-label"></label>
                    <select asp-for="EventType" class="form-select" asp-items="@(EventFormViewModel.EventTypes.Select(t => new SelectListItem(t, t)))"></select>
                    <span asp-validation-for="EventType" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="DistanceKm" class="form-label"></label>
                    <input asp-for="DistanceKm" type="number" step="0.01" min="0.01" max="1000" class="form-control" />
                    <span asp-validation-for="DistanceKm" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="4" maxlength="500"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Banner" class="form-label"></label>
                    <input asp-for="Banner" type="file" class="form-control" accept="image/png,image/jpeg,image/webp,image/gif" data-banner-input />
                    <div class="form-text">
                        JPG, PNG, WEBP or GIF, up to 5 MB. The image is stored in Azure Blob Storage through the API.
                        @if (isEdit && Model.HasBanner) { <span>Choosing a new file replaces the current banner.</span> }
                    </div>
                    <span class="text-danger" data-banner-message></span>
                    <span asp-validation-for="Banner" class="text-danger"></span>

                    <div class="mt-2">
                        @if (isEdit && Model.HasBanner)
                        {
                            <p class="small text-muted mb-1">Current banner</p>
                            <img class="rd-banner-preview" src="@Url.Action("Banner", "Events", new { id = Model.EventId })" alt="Current event banner" />
                        }
                        <img class="rd-banner-preview" data-banner-preview alt="Preview of the chosen banner" hidden />
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary btn-lg" data-busy-text="Saving...">@(isEdit ? "Save changes" : "Create event")</button>
                <a class="btn btn-light btn-lg" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScripts" />
}

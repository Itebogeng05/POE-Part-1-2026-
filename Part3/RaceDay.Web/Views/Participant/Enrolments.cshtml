@model List<EnrolmentDto>
@{
    ViewData["Title"] = "My enrolments";
    var today = DateOnly.FromDateTime(DateTime.UtcNow);
}
<div class="container">
    <div class="rd-page-head">
        <div>
            <span class="rd-eyebrow">Your start list</span>
            <h1>My enrolments</h1>
        </div>
        <a class="btn btn-primary" asp-controller="Home" asp-action="Index"><i class="bi bi-search"></i> Find more events</a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="rd-card rd-empty">
            <i class="bi bi-ticket-perforated"></i>
            <h2>You haven't enrolled in anything yet</h2>
            <p>Pick an event, choose a category and it will show up here straight away.</p>
            <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Browse events</a>
        </div>
    }
    else
    {
        <div class="rd-card rd-table-wrap">
            <table class="rd-table">
                <thead>
                    <tr><th>Event</th><th>Date</th><th>Category</th><th>Enrolled on</th><th>Status</th><th><span class="visually-hidden">Actions</span></th></tr>
                </thead>
                <tbody>
                @foreach (var e in Model)
                {
                    <tr>
                        <td><a asp-controller="Events" asp-action="Details" asp-route-id="@e.EventId" class="fw-semibold">@e.EventName</a></td>
                        <td>@UiFormat.ShortDate(e.EventDate)</td>
                        <td>@e.CategoryName</td>
                        <td>@UiFormat.DateTimeShort(e.EnrolmentDate)</td>
                        <td><partial name="_StatusBadge" model="e.Status" /></td>
                        <td class="text-end">
                            @if (e.EventDate >= today)
                            {
                                <form asp-controller="Participant" asp-action="Cancel" asp-route-id="@e.EnrolmentId" method="post" class="d-inline"
                                      data-confirm="Cancel your enrolment in @e.EventName (@e.CategoryName)? You can enrol again later if there is still space."
                                      data-confirm-title="Cancel enrolment" data-confirm-button="Yes, cancel it">
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-x-lg"></i> Cancel</button>
                                </form>
                            }
                            else
                            {
                                <span class="text-muted small">Event over</span>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

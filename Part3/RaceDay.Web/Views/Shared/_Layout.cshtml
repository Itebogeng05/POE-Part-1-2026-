@{
    var user = Context.Session.GetUser();
    if (user is { IsExpired: true }) { user = null; }
    var controller = (ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty);
    string Active(params string[] names) => names.Contains(controller, StringComparer.OrdinalIgnoreCase) ? "active" : string.Empty;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] is string t && t.Length > 0 ? t + " | " : "")RaceDay</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&family=Barlow+Condensed:wght@600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg rd-navbar" aria-label="Main navigation">
            <div class="container">
                <a class="rd-brand" asp-controller="Home" asp-action="Index" aria-label="RaceDay home">
                    <i class="bi bi-flag-fill rd-brand-flag" aria-hidden="true"></i>
                    <span class="rd-brand-race">RACE</span><span class="rd-brand-day">DAY</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <i class="bi bi-list text-white fs-2"></i>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
                        @if (user is { IsOrganiser: true })
                        {
                            <li class="nav-item"><a class="nav-link @Active("Organiser")" asp-controller="Organiser" asp-action="Index"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link @Active("OrganiserEvents", "OrganiserCategories")" asp-controller="OrganiserEvents" asp-action="Index"><i class="bi bi-calendar-event"></i> My Events</a></li>
                            <li class="nav-item"><a class="nav-link @Active("OrganiserEnrolments")" asp-controller="OrganiserEnrolments" asp-action="Index"><i class="bi bi-people"></i> Enrolments</a></li>
                            <li class="nav-item"><a class="nav-link @Active("OrganiserResults")" asp-controller="OrganiserResults" asp-action="Index"><i class="bi bi-stopwatch"></i> Results</a></li>
                        }
                        else if (user is { IsParticipant: true })
                        {
                            <li class="nav-item"><a class="nav-link @Active("Home", "Events")" asp-controller="Home" asp-action="Index"><i class="bi bi-search"></i> Find Events</a></li>
                            <li class="nav-item"><a class="nav-link @(controller == "Participant" && ViewContext.RouteData.Values["action"]?.ToString() == "Enrolments" ? "active" : "")" asp-controller="Participant" asp-action="Enrolments"><i class="bi bi-ticket-perforated"></i> My Enrolments</a></li>
                            <li class="nav-item"><a class="nav-link @(controller == "Participant" && ViewContext.RouteData.Values["action"]?.ToString() == "Results" ? "active" : "")" asp-controller="Participant" asp-action="Results"><i class="bi bi-trophy"></i> My Results</a></li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link @Active("Home")" asp-controller="Home" asp-action="Index"><i class="bi bi-house"></i> Home</a></li>
                        }
                    </ul>
                    <div class="d-flex align-items-lg-center flex-column flex-lg-row gap-2">
                        @if (user is not null)
                        {
                            <span class="rd-user">
                                <i class="bi bi-person-circle" aria-hidden="true"></i>
                                <span>@user.FullName</span>
                                <span class="rd-role-pill">@user.Role</span>
                            </span>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                <button type="submit" class="btn btn-sm btn-outline-light rd-logout"><i class="bi bi-box-arrow-right"></i> Log out</button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-sm btn-outline-light" asp-controller="Account" asp-action="Login">Log in</a>
                            <a class="btn btn-sm btn-primary" asp-controller="Account" asp-action="Register">Sign up</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="rd-main" id="main">
        <div class="container">
            @if (TempData["Success"] is string ok && ok.Length > 0)
            {
                <div class="alert alert-success rd-alert alert-dismissible fade show" role="alert" data-autodismiss="true">
                    <i class="bi bi-check-circle-fill" aria-hidden="true"></i> <span>@ok</span>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["Error"] is string bad && bad.Length > 0)
            {
                <div class="alert alert-danger rd-alert alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-octagon-fill" aria-hidden="true"></i> <span>@bad</span>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (ViewData["LoadError"] is string loadError && loadError.Length > 0)
            {
                <div class="alert alert-warning rd-alert" role="alert">
                    <i class="bi bi-wifi-off" aria-hidden="true"></i> <span>@loadError</span>
                </div>
            }
            @if (ViewData["Notice"] is string notice && notice.Length > 0)
            {
                <div class="alert alert-info rd-alert" role="alert">
                    <i class="bi bi-info-circle-fill" aria-hidden="true"></i> <span>@notice</span>
                </div>
            }
        </div>
        @RenderBody()
    </main>

    <footer class="rd-footer">
        <div class="container d-flex flex-column flex-md-row justify-content-between gap-2">
            <span><strong>RACEDAY</strong> &middot; Find it. Enter it. Finish it.</span>
            <span class="text-white-50">&copy; @DateTime.UtcNow.Year RaceDay</span>
        </div>
    </footer>

    <!-- Shared confirmation dialog used by every destructive action -->
    <div class="modal fade" id="confirmModal" tabindex="-1" aria-labelledby="confirmTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rd-modal">
                <div class="modal-header border-0 pb-0">
                    <h2 class="modal-title h4" id="confirmTitle">Are you sure?</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="confirmBody"></div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Keep it</button>
                    <button type="button" class="btn btn-danger" id="confirmYes">Yes, continue</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
